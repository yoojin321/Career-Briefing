# ===== Career Briefing 환경변수 =====
# 모든 외부 호출(뉴스 API, LLM, DB)은 서버에서만 수행합니다.
# NEXT_PUBLIC_ 접두사 외의 값은 클라이언트에 노출되지 않습니다.

# --- Supabase (PostgreSQL) ---
# 미설정 시: 인메모리 저장소(개발용, 서버 재시작 시 초기화)로 동작합니다.
# 설정 시: supabase/schema.sql 을 먼저 실행해 테이블/인덱스/함수를 생성하세요.
#          (articles, briefings, briefing_items, analyses, user_states,
#           ingestion_jobs, api_usage + increment_api_usage 함수)
#
# 모든 DB 접근은 서버에서만 수행하므로 URL은 서버 전용 변수(SUPABASE_URL)를 권장합니다.
# service role key는 절대 클라이언트에 노출되면 안 되며 서버에서만 사용됩니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 네이버 뉴스 검색 API ---
# 미설정 시: 네이버 어댑터는 비활성화되고 RSS 어댑터만 동작합니다.
# 상업적 이용/콘텐츠 재사용/AI 활용 조건은 이용약관을 반드시 확인하세요.
#
# 인증 방식 두 가지를 지원합니다(NAVER_API_MODE).
#   hub        : NAVER API HUB (NCP) — https://naverapihub.apigw.ntruss.com/search/v1/news
#                헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY  (기본값)
#   developers : 구형 개발자센터 오픈API — https://openapi.naver.com/v1/search/news.json
#                헤더 X-Naver-Client-Id / X-Naver-Client-Secret
NAVER_API_MODE=hub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
#
# 무료 사용량 보호(요금 발생 방지).
# 검색 API 무료 한도는 하루 25,000회이며, 초과분만 종량제로 과금됩니다.
# 본 서비스는 그보다 훨씬 보수적인 자체 상한으로 호출을 제한합니다.
#   NAVER_MAX_CALLS_PER_INGEST : 1회 수집당 최대 호출 수 (기본 25, 하드맥스 200)
#   NAVER_DAILY_CALL_CAP       : 하루 누적 호출 상한 (기본 500, 하드맥스 5000)
NAVER_MAX_CALLS_PER_INGEST=25
NAVER_DAILY_CALL_CAP=500

# --- LLM (OpenAI 호환 Chat Completions) ---
# 중요: 이 파일(.env.example)은 Git에 커밋되는 템플릿입니다. 실제 키를 넣지 마세요.
#       실제 키는 .env.local 에만 입력하세요(.gitignore로 제외됨).
# BASE_URL을 바꾸면 다른 OpenAI 호환 제공자로 교체할 수 있습니다.
# 미설정 시: AI 분석은 "미설정" 상태로 표시되고 가짜 분석을 생성하지 않습니다.
#
# [기본: OpenAI]
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# [BAZE API Gateway]
#   호출 경로는 {BASE_URL}/chat/completions/ (끝 슬래시)로 구성됩니다.
#   인증: Authorization: Bearer <KEY>
#   모델명은 /api/llm-check 로 실제 사용 가능 여부를 확인한 뒤 설정하세요.
LLM_API_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
# Claude 계열 모델은 response_format(json_object)을 지원하지 않을 수 있어 기본 비활성(0).
# OpenAI 모델에서 JSON 모드를 강제하려면 1로 설정하세요.
LLM_JSON_MODE=0
#
# 공개 분석 API 비용 보호: 하루 전체 AI 분석(BAZE 실제 호출) 상한.
# 미설정 시 기본 50. 운영 규모에 맞춰 상향(하드맥스 2000).
# 이미 분석된 기사 재조회는 이 상한을 소모하지 않습니다(재사용).
ANALYSIS_DAILY_CAP=50
#
# 원문 본문 활용(대안 B): 분석 실행 시점에만 본문을 일시적으로 가져와
# LLM 입력으로만 사용하고 DB에 저장하지 않습니다. robots.txt를 확인해
# 허용된 경우에만 가져오며, 차단/실패 시 제목·공식 요약으로 폴백합니다.
#   ARTICLE_BODY_FETCH    : 0으로 설정하면 본문 수집 비활성(기본 활성)
#   ARTICLE_BODY_MAX_CHARS: LLM에 넣을 본문 최대 길이(기본 6000, 하드맥스 20000)
# 주의: 대상 언론사의 이용약관/robots 정책을 준수할 책임은 운영자에게 있습니다.
ARTICLE_BODY_FETCH=1
ARTICLE_BODY_MAX_CHARS=6000

# --- 운영/보안 ---
# 관리자 수동 트리거(/api/ingest, /api/select, /api/analyze) 보호용.
# 미설정 시 관리자 API는 401로 비활성화됩니다.
ADMIN_SECRET=
# Vercel Cron(/api/cron) 보호용. Vercel은 Authorization: Bearer <CRON_SECRET>로 호출.
CRON_SECRET=

# --- 개인용 로그인 (AI 분석 보호) ---
# AI 분석(POST /api/news/[id]/analyze)은 로그인한 사용자만 실행할 수 있습니다.
# 뉴스 목록/검색 조회는 로그인 없이 공개됩니다.
# 둘 다 미설정이면 분석 API는 503(보호 미구성)으로 비활성화됩니다(비용 방지).
#   APP_PASSWORD   : 로그인 시 입력할 비밀번호
#   SESSION_SECRET : 세션 쿠키(HttpOnly) 서명용 긴 랜덤 문자열(32자 이상 권장)
#                    미설정 시 ADMIN_SECRET로 폴백됩니다.
APP_PASSWORD=
SESSION_SECRET=
